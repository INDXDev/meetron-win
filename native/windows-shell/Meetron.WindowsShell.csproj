<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Meetron.WindowsShell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- The shell is built unpackaged (WindowsPackageType None) but ships
         wrapped in the MSIX, so it runs with package identity. MRT then
         resolves every ms-appx:/// URI against the package's resources.pri,
         and an unpackaged build names its index $(TargetName).pri with a
         $(TargetName) root resource map. Neither matches what a package
         needs, so XAML cannot find themeresources.xaml and the window throws
         before it opens. Name the index the way a package is read, and give
         its root map the MSIX identity from package-windows-release.mjs. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ProjectPriIndexName>io.github.bb8ad8.meetron</ProjectPriIndexName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>
</Project>
